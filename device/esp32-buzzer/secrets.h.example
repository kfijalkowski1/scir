// Copy this file to `secrets.h` and fill in the placeholders.
// `secrets.h` is gitignored.
//
// AWS IoT material is generated by Terragrunt and exported as sensitive outputs
// from cloud/modules/iot-core/outputs.tf. Pull them with:
//
//   cd cloud/environments/prod/iot
//   terragrunt output -raw iot_data_endpoint
//   terragrunt output -raw esp_certificate_pem
//   terragrunt output -raw esp_private_key
//
// The Amazon Root CA1 PEM is fetched from
// https://www.amazontrust.com/repository/AmazonRootCA1.pem
//
// IMPORTANT:
// - MQTT_CLIENT_ID must match the IoT Thing name exactly. The IoT policy
//   pins iot:Connect to client/${iot:Connection.Thing.ThingName}.
// - PEM blocks must keep the BEGIN/END lines and trailing newlines.

